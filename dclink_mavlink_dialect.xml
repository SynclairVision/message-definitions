  <messages>
    <message id="41000" name="DCLINK_STATUS">
      <description>High-level DCLink runtime status.</description>
      <field type="uint16_t" name="request_id">Client request id copied into the response.</field>
      <field type="uint8_t" name="autopilot_connection" enum="DCLINK_AUTOPILOT_CONNECTION">Autopilot connection state.</field>
      <field type="uint8_t" name="autopilot_type" enum="DCLINK_AUTOPILOT_TYPE">Detected autopilot type.</field>
      <field type="uint16_t" name="active_command_id">Active command id; 0 means no running command.</field>
      <field type="char[64]" name="active_command">Active command name; empty or idle means no running command.</field>
      <field type="uint8_t" name="command_state" enum="DCLINK_COMMAND_STATE">Current command runtime state.</field>
      <field type="uint8_t" name="navigation_type" enum="DCLINK_NAVIGATION_TYPE">Current navigation source.</field>
      <field type="uint8_t" name="navigation_status" enum="DCLINK_NAVIGATION_STATUS">Current navigation health/status.</field>
      <field type="uint8_t" name="target_status" enum="DCLINK_TARGET_STATUS">Current target status.</field>
      <field type="uint8_t" name="logging" enum="DCLINK_LOGGING_STATUS">Logging state.</field>
      <field type="uint32_t" name="flags">Reserved status bitmask.</field>
    </message>

    <message id="41001" name="DCLINK_COMMAND">
      <description>List, start, stop, or acknowledge a DCLink command.</description>
      <field type="uint16_t" name="request_id">Client request id copied into the response.</field>
      <field type="uint8_t" name="action" enum="DCLINK_ACTION">Requested action or response action.</field>
      <field type="uint8_t" name="result" enum="DCLINK_RESULT">Action result for ACK/ERROR responses.</field>
      <field type="uint16_t" name="total">Total available commands for list responses.</field>
      <field type="uint16_t" name="id">Command id; 0 is the command-list root for GET.</field>
      <field type="char[64]" name="name">Command machine name, for example hold or copter/takeoff.</field>
      <field type="char[48]" name="label">Human-readable command label.</field>
      <field type="char[32]" name="section">UI/group section, for example main or copter.</field>
      <field type="uint32_t" name="flags">Reserved command capability bitmask.</field>
      <field type="uint8_t" name="access_role" enum="DCLINK_PARAMETER_ACCESS_ROLE" display="bitmask">Roles allowed to access this command. Zero means unspecified metadata.</field>
    </message>

    <message id="41002" name="DCLINK_PARAMETER">
      <description>List, set, or acknowledge a DCLink runtime parameter.</description>
      <field type="uint16_t" name="request_id">Client request id copied into the response.</field>
      <field type="uint8_t" name="action" enum="DCLINK_ACTION">Requested action or response action.</field>
      <field type="uint8_t" name="result" enum="DCLINK_RESULT">Action result for ACK/ERROR responses.</field>
      <field type="uint16_t" name="total">Total available parameters for list responses.</field>
      <field type="uint16_t" name="id">Parameter id; 0 is the parameter-list root for GET.</field>
      <field type="char[64]" name="name">Parameter key/name.</field>
      <field type="char[96]" name="value">Parameter value encoded as UTF-8 text.</field>
      <field type="char[48]" name="section">UI/group section, for example core, safety, or navigation.</field>
      <field type="uint32_t" name="flags">Reserved parameter bitmask.</field>
      <field type="uint8_t" name="access_role" enum="DCLINK_PARAMETER_ACCESS_ROLE" display="bitmask">Roles allowed to access this parameter. Zero means unspecified metadata.</field>
    </message>
    <message id="41003" name="DCLINK_TARGET_VIEW">
      <description>Read-only selected runtime target. Query: every field zero except request_id. Reply: schema_version=1. Validity flags govern all geometry; zero is never an unavailable sentinel. Angles require no range or GPS. Replies do not establish service liveness.</description>
      <field type="uint32_t" name="request_id">Independent read correlation ID; never reused within a client lifetime.</field>
      <field type="uint64_t" name="boot_id">Random nonzero endpoint lifetime identity.</field>
      <field type="uint32_t" name="sequence">Increasing reply sequence within boot_id.</field>
      <field type="uint32_t" name="flags" enum="DCLINK_TARGET_VIEW_FLAGS">Independent validity and target state bits.</field>
      <field type="uint32_t" name="age_ms" units="ms">Age of selected observation on receipt at DCLink.</field>
      <field type="uint32_t" name="source_age_ms" units="ms">Measurement age when SOURCE_AGE is set.</field>
      <field type="uint16_t" name="valid_for_ms" units="ms">Remaining target lifetime at reply creation, at most 3000 ms. Client subtracts full query round trip.</field>
      <field type="float" name="azimuth_deg" units="deg">Aircraft-relative nose azimuth, positive right, wrapped to [-180,180].</field>
      <field type="float" name="elevation_deg" units="deg">Body-frame line-of-sight elevation, positive up, [-90,90].</field>
      <field type="float" name="horizontal_range_m" units="m">Horizontal range estimate; never slant range.</field>
      <field type="double" name="latitude_deg" units="deg">Target latitude in WGS84 degrees.</field>
      <field type="double" name="longitude_deg" units="deg">Target longitude in WGS84 degrees.</field>
      <field type="float" name="relative_north_m" units="m">Target minus aircraft north offset in local NED.</field>
      <field type="float" name="relative_east_m" units="m">Target minus aircraft east offset in local NED.</field>
      <field type="uint8_t" name="schema_version">Zero for query, one for reply.</field>
      <field type="uint8_t" name="vehicle_system_id">Aircraft associated with the runtime observation.</field>
      <field type="uint8_t" name="vehicle_component_id">Aircraft component associated with the runtime observation.</field>
      <field type="uint8_t" name="control_owner" enum="DCLINK_CONTROL_OWNER">Reported runtime control authority, independent of active command.</field>
      <field type="uint8_t" name="range_source" enum="DCLINK_RANGE_SOURCE">Range provenance, independent of angle validity.</field>
      <field type="char[32]" name="target_id">Selected track ID if supplied; empty means unknown. UTF-8.</field>
      <field type="char[24]" name="target_source">Selected observation source if supplied; empty means unknown. UTF-8.</field>
    </message>
  </messages>
</mavlink>
