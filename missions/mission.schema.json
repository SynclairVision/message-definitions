{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SynclairVision/message-definitions/dev-0.8-qgc-missions/missions/mission.schema.json",
  "title": "DCLink mission content version 2",
  "description": "Editable mission content, separate from the service-assigned mission ID and revision. Saving content does not authorize execution.",
  "$comment": "The service also checks duplicate object keys, finite numbers, unique waypoint, rule and area IDs, valid waypoint and area references, consecutive leg endpoints, simple polygons with nonzero area and longitude span below 180 degrees, a 300-second total wait limit, and a 262144-byte UTF-8 document limit. Execution requires a waypoint and independent readiness checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "altitude_reference",
    "waypoints",
    "rules",
    "areas"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "altitude_reference": {
      "type": "string",
      "const": "relative_home",
      "description": "Metres above the admitted aircraft HOME altitude, not terrain clearance. HOME availability is checked before execution."
    },
    "waypoints": {
      "type": "array",
      "description": "Ordered route. Empty saved drafts are allowed. Waypoint IDs must be unique within the mission; the service checks ID uniqueness because JSON Schema cannot express uniqueness of one object property.",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/waypoint"
      }
    },
    "rules": {
      "type": "array",
      "description": "Ordered rules. Each eligible rule runs at most once per run. Rules that become eligible together run in saved order.",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "areas": {
      "type": "array",
      "description": "Ordered geographic areas for rule conditions and operator advisories. Each area ID is unique within the mission.",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/area"
      }
    }
  },
  "$defs": {
    "clean_text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f\ud800-\udfff]"
          }
        },
        {
          "not": {
            "pattern": "^[\\s\uFEFF]|[\\s\uFEFF]$"
          }
        }
      ]
    },
    "name": {
      "$ref": "#/$defs/clean_text",
      "description": "A label of 1–80 Unicode scalar values without controls, edge whitespace, or edge BOMs.",
      "maxLength": 80
    },
    "message_text": {
      "$ref": "#/$defs/clean_text",
      "description": "Pilot-facing message of 1–100 Unicode scalar values without controls, edge whitespace, or edge BOMs.",
      "maxLength": 100
    },
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "latitude_deg",
        "longitude_deg",
        "altitude_m",
        "acceptance_radius_m"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Lowercase UUIDv4, stable through coordinate edits and reordering, and unique within this mission."
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": "number",
          "description": "Finite metres relative to HOME. Configured flight altitude limits are checked separately before and during execution."
        },
        "acceptance_radius_m": {
          "type": "number",
          "description": "Finite positive metres for this waypoint. Editors initially offer 30 metres; execution must honor the saved value or reject unsupported behavior.",
          "exclusiveMinimum": 0
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "actions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Lowercase UUIDv4, unique among the rules in this mission."
        },
        "trigger": {
          "oneOf": [
            {
              "$ref": "#/$defs/waypoint_reached"
            },
            {
              "$ref": "#/$defs/leg_started"
            },
            {
              "$ref": "#/$defs/leg_progress"
            }
          ]
        },
        "condition": {
          "$ref": "#/$defs/detection_present"
        },
        "area_id": {
          "$ref": "#/$defs/id",
          "description": "An area in this mission. The aircraft must be inside that area when the rule is checked. If a detection condition also exists, both must be satisfied."
        },
        "actions": {
          "type": "array",
          "description": "Ordered steps. Each step completes before the next; the route continues after the last matching rule.",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/notify"
              },
              {
                "$ref": "#/$defs/wait"
              }
            ]
          }
        }
      },
      "if": {
        "properties": {
          "trigger": {
            "not": {
              "$ref": "#/$defs/waypoint_reached"
            }
          }
        }
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/$defs/notify"
            }
          }
        }
      }
    },
    "waypoint_reached": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "waypoint_id"],
      "properties": {
        "type": {
          "const": "waypoint_reached"
        },
        "waypoint_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "leg_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from_waypoint_id", "to_waypoint_id"],
      "properties": {
        "type": {
          "const": "leg_started"
        },
        "from_waypoint_id": {
          "$ref": "#/$defs/id"
        },
        "to_waypoint_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "leg_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from_waypoint_id", "to_waypoint_id", "position"],
      "properties": {
        "type": {
          "const": "leg_progress"
        },
        "from_waypoint_id": {
          "$ref": "#/$defs/id"
        },
        "to_waypoint_id": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "anywhere"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "percent"],
              "properties": {
                "type": {
                  "const": "percent"
                },
                "percent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          ]
        }
      }
    },
    "detection_present": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "detection_present"
        },
        "class_id": {
          "type": "integer",
          "description": "Exact class ID from the detector model. Omit to match any fresh, active classified detection.",
          "minimum": 0,
          "maximum": 32767
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "notify"
        },
        "text": {
          "$ref": "#/$defs/message_text"
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "vertices"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Lowercase UUIDv4, stable through edits and unique among the areas in this mission."
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "vertices": {
          "type": "array",
          "description": "Corners in boundary order. The closing edge is implicit. The service checks polygon geometry.",
          "minItems": 3,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/area_vertex"
          }
        },
        "advisory": {
          "$ref": "#/$defs/message_text",
          "description": "Optional operator message displayed while the aircraft is inside the area."
        }
      }
    },
    "area_vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude_deg", "longitude_deg"],
      "properties": {
        "latitude_deg": {
          "type": "number",
          "exclusiveMinimum": -90,
          "exclusiveMaximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration_s"],
      "properties": {
        "type": {
          "const": "wait"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    }
  }
}
