{
  "schema_version": 2,
  "name": "Synthetic route - not for flight",
  "altitude_reference": "relative_home",
  "waypoints": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "latitude_deg": 0,
      "longitude_deg": 0,
      "altitude_m": 30,
      "acceptance_radius_m": 30
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "latitude_deg": 0.001,
      "longitude_deg": 0.001,
      "altitude_m": 30,
      "acceptance_radius_m": 30
    }
  ],
  "rules": [
    {
      "id": "00000000-0000-4000-8000-000000000101",
      "trigger": {
        "type": "waypoint_reached",
        "waypoint_id": "00000000-0000-4000-8000-000000000001"
      },
      "actions": [
        {"type": "notify", "text": "Reached the first waypoint"},
        {"type": "wait", "duration_s": 5},
        {"type": "notify", "text": "Continuing the route"}
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000102",
      "trigger": {
        "type": "leg_started",
        "from_waypoint_id": "00000000-0000-4000-8000-000000000001",
        "to_waypoint_id": "00000000-0000-4000-8000-000000000002"
      },
      "actions": [
        {"type": "command", "command_id": "copter/rotate_north"},
        {"type": "notify", "text": "Moving to the second waypoint"}
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000103",
      "trigger": {
        "type": "leg_progress",
        "from_waypoint_id": "00000000-0000-4000-8000-000000000001",
        "to_waypoint_id": "00000000-0000-4000-8000-000000000002",
        "position": {"type": "anywhere"}
      },
      "condition": {"type": "detection_present"},
      "area_id": "00000000-0000-4000-8000-000000000201",
      "actions": [
        {"type": "notify", "text": "A detection was reported in the survey area"}
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000104",
      "trigger": {
        "type": "leg_progress",
        "from_waypoint_id": "00000000-0000-4000-8000-000000000001",
        "to_waypoint_id": "00000000-0000-4000-8000-000000000002",
        "position": {"type": "percent", "percent": 50}
      },
      "condition": {"type": "detection_present", "class_id": 3},
      "actions": [
        {"type": "notify", "text": "Class 3 was detected halfway along the leg"}
      ]
    }
  ],
  "areas": [
    {
      "id": "00000000-0000-4000-8000-000000000201",
      "name": "Survey area",
      "vertices": [
        {"latitude_deg": 0.00035, "longitude_deg": 0.00035},
        {"latitude_deg": 0.00035, "longitude_deg": 0.00075},
        {"latitude_deg": 0.00075, "longitude_deg": 0.00075},
        {"latitude_deg": 0.00075, "longitude_deg": 0.00035}
      ],
      "advisory": "Survey area: monitor camera observations"
    }
  ]
}
